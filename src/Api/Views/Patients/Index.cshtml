@model IEnumerable<Application.DTOs.PatientDto>
@{
    ViewData["Title"] = "Pacientes";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2 class="mb-0">Pacientes</h2>
            <small class="text-muted">EF Core InMemory + seeding e arquitetura em camadas</small>
        </div>
        <a href="/Patients/Create" class="btn btn-primary">
            <i class="bi bi-person-plus-fill"></i> Adicionar Paciente
        </a>
    </div>

    <div class="table-responsive">
        <table class="table table-hover table-bordered align-middle">
            <thead class="table-light">
                <tr>
                    <th>Nome</th>
                    <th>Data de nascimento</th>
                    <th>Último exame</th>
                    <th class="text-end">Ações</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model)
                {
                    <tr>
                        <td>@p.Name</td>
                        <td>@p.BirthDate.ToString("dd/MM/yyyy")</td>
                        <td>@p.LastExam</td>
                        <td class="text-end">
                            <div class="d-flex justify-content-end flex-wrap gap-2">
                                <a href="/Patients/Details/@p.Id" class="btn btn-outline-primary btn-sm" title="Ver detalhes">
                                    <i class="bi bi-eye-fill"></i> Detalhes
                                </a>
                                <a href="/Patients/Edit/@p.Id" class="btn btn-outline-warning btn-sm" title="Editar paciente">
                                    <i class="bi bi-pencil-square"></i> Editar
                                </a>
                                <form method="post" action="/Patients/Delete/@p.Id" class="d-inline">
                                    <button type="submit" class="btn btn-outline-danger btn-sm" title="Excluir paciente">
                                        <i class="bi bi-trash3"></i> Excluir
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="mt-4">
        <strong>Concorrência com lock distribuído</strong><br />
        Clique múltiplas vezes para validar: apenas uma requisição executa, as demais são bloqueadas.
        <br />
        <button id="btnProcessar" class="btn btn-outline-secondary mt-2">
            Testar Processamento de Relatório
        </button>
        <div id="resultado" class="mt-2 fw-bold"></div>
    </div>

</div>

@section Scripts {
    <script>
        document.getElementById("btnProcessar").addEventListener("click", async function () {
            const resultDiv = document.getElementById("resultado");
            resultDiv.innerText = "Processando...";
            resultDiv.className = "mt-2 fw-bold text-info";

            try {
                const response = await fetch("/processar-relatorio", { method: "POST" });
                const data = await response.json();

                resultDiv.innerText = data.message;

                if (data.message.includes("concluído")) {
                    resultDiv.className = "mt-2 fw-bold text-success";
                } else {
                    resultDiv.className = "mt-2 fw-bold text-danger";
                }
            } catch (err) {
                resultDiv.innerText = "Erro ao chamar o endpoint.";
                resultDiv.className = "mt-2 fw-bold text-danger";
            }
        });
    </script>
}
