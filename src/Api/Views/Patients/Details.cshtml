@model Application.DTOs.PatientDto

@{
    ViewData["Title"] = "Detalhes do Paciente";
}

<div class="container py-5">
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0">
                <i class="bi bi-person-vcard-fill me-2"></i>Detalhes do Paciente
            </h4>
        </div>
        <div class="card-body">
            <div class="mb-3">
                <label class="form-label fw-bold">Nome</label>
                <div class="form-control-plaintext">@Model.Name</div>
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold">Data de Nascimento</label>
                <div class="form-control-plaintext">@Model.BirthDate.ToString("dd/MM/yyyy")</div>
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold">Último Exame</label>
                <div class="form-control-plaintext">@Model.LastExam</div>
            </div>
        </div>
        <div class="card-footer text-end">
            <a asp-action="Index" class="btn btn-outline-secondary me-2">
                <i class="bi bi-arrow-left-circle"></i> Voltar
            </a>
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-warning me-2">
                <i class="bi bi-pencil-square"></i> Editar
            </a>
            <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="d-inline">
                <button type="submit" class="btn btn-outline-danger">
                    <i class="bi bi-trash3"></i> Excluir
                </button>
            </form>
        </div>
    </div>
</div>
