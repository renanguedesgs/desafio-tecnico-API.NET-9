@model Application.DTOs.PatientDto

@{
    ViewData["Title"] = "Editar Paciente";
}

<div class="container py-4">
    <h2 class="mb-3">Editar Paciente</h2>

    <form asp-action="Edit" method="post" class="row g-3">
        <input type="hidden" asp-for="Id" />

        <div class="col-md-6">
            <label asp-for="Name" class="form-label">Nome</label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <div class="col-md-6">
            <label asp-for="BirthDate" class="form-label">Data de Nascimento</label>
            <input asp-for="BirthDate" type="date" class="form-control" />
            <span asp-validation-for="BirthDate" class="text-danger"></span>
        </div>

        <div class="col-12">
            <label asp-for="LastExam" class="form-label">Último Exame</label>
            <input asp-for="LastExam" class="form-control" />
            <span asp-validation-for="LastExam" class="text-danger"></span>
        </div>

        <div class="col-12">
            <button type="submit" class="btn btn-warning">Atualizar</button>
            <a asp-action="Index" class="btn btn-secondary">Voltar</a>
        </div>
    </form>
</div>
